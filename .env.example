NODE_ENV=production

# ─── Supabase Config ────────────────────────────────
# For production (Railway/Render): use SUPABASE_URL and SUPABASE_ANON_KEY
# For local development: use VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Development-only (will be compiled into bundle at build time)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
INTERAKT_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ─── Telephony Provider ────────────────────────────────
# sim    = local simulator (development, no real calls)
# tata   = Tata Tele SmartFlo (current production default — active account, click-to-call live)
# exotel = Exotel (evaluation only — trial account still KYC-gated, provider code untested
#          against a real account; don't switch production over until that's resolved)
TELEPHONY_PROVIDER=sim

# Tata Tele SmartFlo API configuration
# Get TATA_ACCESS_TOKEN from your Tata Tele account manager
# (request a Permanent Access Token — lasts forever, no refresh needed)
TATA_ACCESS_TOKEN=
TATA_BASE_URL=https://api-smartflo.tatateleservices.com/v1

# Webhook callback URL where Tata POSTs call lifecycle events
# Update this when deploying to staging/production
# Development: not used (simulator mode)
# Railway: https://your-railway-app.railway.app/api/telephony/webhook
# (Get your Railway URL from dashboard after first deploy)
TATA_WEBHOOK_URL=

# Exotel API configuration (evaluation only — not the active provider yet, see above)
# Get EXOTEL_SID, EXOTEL_API_KEY, EXOTEL_API_TOKEN from the Exotel dashboard
# (Settings > API Credentials). EXOTEL_SUBDOMAIN is api.in.exotel.com (Mumbai) or
# api.exotel.com (Singapore) depending on which region the account was provisioned in.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.in.exotel.com
# ExoPhone (virtual number) shown to the debtor — must be a number assigned to the account.
EXOTEL_CALLER_ID=
# Only needed for WhatsApp send via Exotel's WhatsApp Business API — the channel id shown
# on the Exotel WhatsApp dashboard once a WhatsApp Business Account is connected.
EXOTEL_WHATSAPP_CHANNEL_ID=

# Webhook callback URL where Exotel POSTs call lifecycle events
# Development: not used (simulator mode)
# Railway: https://your-railway-app.railway.app/api/telephony/webhook
EXOTEL_WEBHOOK_URL=

# App URL for client-side redirects and external references
# Railway: https://your-railway-app.railway.app
VITE_APP_URL=
