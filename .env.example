NODE_ENV=production

# ─── Supabase Config ────────────────────────────────
# For production (Railway/Render): use SUPABASE_URL and SUPABASE_ANON_KEY
# For local development: use VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Development-only (will be compiled into bundle at build time)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
INTERAKT_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ─── Telephony Provider ────────────────────────────────
# sim = local simulator (development, no real calls)
# tata = Tata Tele SmartFlo (staging/production)
TELEPHONY_PROVIDER=sim

# Tata Tele SmartFlo API configuration
# Get TATA_ACCESS_TOKEN from your Tata Tele account manager
# (request a Permanent Access Token — lasts forever, no refresh needed)
TATA_ACCESS_TOKEN=
TATA_BASE_URL=https://api-smartflo.tatateleservices.com/v1

# Webhook callback URL where Tata POSTs call lifecycle events
# Update this when deploying to staging/production
# Development: not used (simulator mode)
# Railway: https://your-railway-app.railway.app/api/telephony/webhook
# (Get your Railway URL from dashboard after first deploy)
TATA_WEBHOOK_URL=

# App URL for client-side redirects and external references
# Railway: https://your-railway-app.railway.app
VITE_APP_URL=
