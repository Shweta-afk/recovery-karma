NODE_ENV=production
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
INTERAKT_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ─── Telephony Provider ────────────────────────────────
# sim = local simulator (development, no real calls)
# tata = Tata Tele SmartFlo (staging/production)
TELEPHONY_PROVIDER=sim

# Tata Tele SmartFlo API configuration
# Get TATA_ACCESS_TOKEN from your Tata Tele account manager
# (request a Permanent Access Token — lasts forever, no refresh needed)
TATA_ACCESS_TOKEN=
TATA_BASE_URL=https://api-smartflo.tatateleservices.com/v1

# Webhook callback URL where Tata POSTs call lifecycle events
# Update this when deploying to staging/production
# Development: not used (simulator mode)
# Staging: https://staging-recovery-karma.onrender.com/api/telephony/webhook
# Production: https://recovery-karma.onrender.com/api/telephony/webhook
TATA_WEBHOOK_URL=

VITE_APP_URL=
