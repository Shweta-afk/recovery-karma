NODE_ENV=production

# ─── Supabase Config ────────────────────────────────
# For production (Railway/Render): use SUPABASE_URL and SUPABASE_ANON_KEY
# For local development: use VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Development-only (will be compiled into bundle at build time)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
# Call sentiment analysis (manager-triggered, see call-sentiment-actions.server.ts):
# transcription via Groq's free Whisper API, tone classification via Gemini's free API.
GROQ_API_KEY=
GEMINI_API_KEY=
INTERAKT_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ─── ProfileX (Neokred) skip tracing ───────────────────
# Manager-triggered lookups that turn a debtor's own phone number into their UAN, employer and
# demographics. BILLED PER CALL by Neokred — including when nothing is found — and there is no
# balance API, so spend is metered in the `debtor_traces` table and capped by the monthly budget
# in Admin > Settings. Server-only: never add a VITE_ prefix, these must not reach the browser.
# Leave blank to keep the feature off (it is also gated by an admin toggle per client).
PROFILEX_BASE_URL=https://profilex-api.neokred.tech
# The console's "Client Hash ID" field — NOT the "User Hash ID" sitting next to it. Sending the
# User Hash ID returns HTTP 500 "You Dont Have UAT Access!!!", indistinguishable from the account
# genuinely lacking access. This variable is named after the console's own label so the two
# cannot be confused. (PROFILEX_CLIENT_USER_ID is the legacy name and is still read as a
# fallback, but prefer this one.)
PROFILEX_CLIENT_HASH_ID=
PROFILEX_SECRET_KEY=
PROFILEX_ACCESS_KEY=

# ─── Telephony Provider ────────────────────────────────
# sim    = local simulator (development, no real calls)
# exotel = Exotel (production default — trial account KYC complete, click-to-call live)
# Tata Tele SmartFlo was evaluated and dropped; its provider code has been removed.
TELEPHONY_PROVIDER=sim

# Exotel API configuration
# Get EXOTEL_SID, EXOTEL_API_KEY, EXOTEL_API_TOKEN from the Exotel dashboard
# (Settings > API Credentials). EXOTEL_SUBDOMAIN is api.in.exotel.com (Mumbai) or
# api.exotel.com (Singapore) depending on which region the account was provisioned in.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.in.exotel.com
# ExoPhone (virtual number) shown to the debtor — must be a number assigned to the account.
EXOTEL_CALLER_ID=
# Only needed for WhatsApp send via Exotel's WhatsApp Business API — the channel id shown
# on the Exotel WhatsApp dashboard once a WhatsApp Business Account is connected.
EXOTEL_WHATSAPP_CHANNEL_ID=

# Webhook callback URL where Exotel POSTs call lifecycle events
# Development: not used (simulator mode)
# Railway: https://your-railway-app.railway.app/api/telephony/webhook
EXOTEL_WEBHOOK_URL=

# Client-safe (baked in at build time): comma-separated ExoPhone(s) assigned to the account,
# used to populate manual-dial caller ID pickers in the UI.
VITE_TELEPHONY_CALLER_IDS=

# App URL for client-side redirects and external references
# Railway: https://your-railway-app.railway.app
VITE_APP_URL=
