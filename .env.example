NODE_ENV=production

# ─── Supabase Config ────────────────────────────────
# For production (Railway/Render): use SUPABASE_URL and SUPABASE_ANON_KEY
# For local development: use VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Development-only (will be compiled into bundle at build time)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
# Call sentiment analysis (manager-triggered, see call-sentiment-actions.server.ts):
# transcription via Groq's free Whisper API, tone classification via Gemini's free API.
GROQ_API_KEY=
GEMINI_API_KEY=
INTERAKT_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ─── ProfileX (Neokred) skip tracing ───────────────────
# Manager-triggered lookups that turn a debtor's own phone number into their UAN, employer and
# demographics. BILLED PER CALL by Neokred — including when nothing is found — and there is no
# balance API, so spend is metered in the `debtor_traces` table and capped by the monthly budget
# in Admin > Settings. Server-only: never add a VITE_ prefix, these must not reach the browser.
# Leave blank to keep the feature off (it is also gated by an admin toggle per client).
PROFILEX_BASE_URL=https://profilex-api.neokred.tech
# The console's "Client Hash ID" field — NOT the "User Hash ID" sitting next to it. Sending the
# User Hash ID returns HTTP 500 "You Dont Have UAT Access!!!", indistinguishable from the account
# genuinely lacking access. This variable is named after the console's own label so the two
# cannot be confused. (PROFILEX_CLIENT_USER_ID is the legacy name and is still read as a
# fallback, but prefer this one.)
PROFILEX_CLIENT_HASH_ID=
PROFILEX_SECRET_KEY=
PROFILEX_ACCESS_KEY=

# Required to create the FIRST superadmin (while the superadmins table is empty). Without it the
# /superadmin-setup route refuses, so a fresh or restored database can't be claimed by whoever
# finds the URL first. Generate one with:  openssl rand -hex 32
SUPERADMIN_BOOTSTRAP_SECRET=

# ─── Telephony Provider ────────────────────────────────
# sim     = local simulator (development, no real calls) — the default
# skycrm  = SkyCRM-ACD POC adapter (see SKYCRM_* below)
# Exotel and Tata Tele SmartFlo were dropped; their provider code has been removed.
TELEPHONY_PROVIDER=sim

# Shared secret the telephony vendor must present on POST /api/telephony/webhook, either as an
# `x-webhook-secret` header or a `?secret=` query parameter on the callback URL. The endpoint
# REJECTS every request while this is unset, so set it before pointing a vendor at the app.
# Generate one with:  openssl rand -hex 32
TELEPHONY_WEBHOOK_SECRET=

# Client-safe (baked in at build time): comma-separated DID(s) assigned to the account,
# used to populate manual-dial caller ID pickers in the UI.
VITE_TELEPHONY_CALLER_IDS=

# ─── SkyCRM-ACD (Intellect Info Trade) — TELEPHONY_PROVIDER=skycrm ──────────────
# REST call-control (POC phase). Base host + HS256 signing secret the vendor issues (the v1.2
# PDF's leading space is formatting, NOT part of the key). USER/PASS = service account; PREFIX =
# vendor-assigned dialing prefix (for the test env it was "same as the extension").
# NOTE: the test env has no telephone channel, so dialing_phone cannot place a real call there.
SKYCRM_BASE_URL=https://api.skycrm.app
SKYCRM_SECRET=
SKYCRM_USER=
SKYCRM_PASS=
SKYCRM_PREFIX=

# ─── SkyCRM WebRTC webphone (SIP.js, browser calling — Phase 2) ─────────────────
# Client-side (VITE_-prefixed → in the browser bundle). Powers /webphone-test and, later, the
# in-app dialer. LEAVE BLANK until the vendor enables WebRTC and sends the WSS endpoint — the
# webphone stays inert (shows "not configured") until VITE_SKYCRM_WSS_URL is set.
# ⚠️ SECURITY: VITE_SKYCRM_SIP_PASSWORD is baked into the client bundle — POC/test only. For
# production, mint short-lived per-agent SIP creds server-side instead of shipping a password.
VITE_SKYCRM_WSS_URL=
VITE_SKYCRM_SIP_DOMAIN=
VITE_SKYCRM_SIP_EXTENSION=
VITE_SKYCRM_SIP_PASSWORD=
# Optional STUN/TURN for NAT traversal — JSON array of RTCIceServer, e.g.
# [{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:host:3478","username":"u","credential":"p"}]
VITE_SKYCRM_ICE_SERVERS=

# App URL for client-side redirects and external references
# Railway: https://your-railway-app.railway.app
VITE_APP_URL=
