# PRODUCTION tunnel: IPsec site-to-site between this gateway and SkyCRM's FortiGate.
# setup.sh (TUNNEL=ipsec) fills the __PLACEHOLDERS__ from /etc/samvadx-gateway.env and writes
# /etc/swanctl/conf.d/skycrm.conf. The pre-shared key is NOT here: set-ipsec-psk.sh asks for it
# and writes skycrm-secret.conf (root-only).
#
# Live since 2026-11-03 with exactly these settings: we proposed them and SkyCRM accepted them
# unchanged. Their peer is the same FortiGate as the SSL VPN (118.185.178.161).
connections {
  skycrm {
    version = 2
    # DigitalOcean puts the public IP straight on eth0 (no cloud NAT), so local = public.
    local_addrs  = __PUBLIC_IP__
    remote_addrs = __SKYCRM_PEER_IP__
    proposals = aes256-sha256-modp2048        # phase 1: AES-256 / SHA-256 / DH group 14
    rekey_time = 28800s                       # phase 1 lifetime
    dpd_delay = 30s

    local {
      auth = psk
      id = __PUBLIC_IP__
    }
    remote {
      auth = psk
      id = %any                               # accept whatever ID the FortiGate presents
    }

    children {
      skycrm-sip {
        # Our end: one address on loopback (samvadx-tunnel-ip.service), used by Kamailio and
        # rtpengine. Their end: the SIP/WebRTC servers 10.173.16.10 and .4.
        local_ts  = __TUNNEL_IP__/32
        remote_ts = 10.173.16.0/24
        esp_proposals = aes256-sha256-modp2048  # phase 2: AES-256 / SHA-256 / PFS group 14
        rekey_time = 3600s                      # phase 2 lifetime
        start_action = start                    # bring it up at boot
        dpd_action = restart
        close_action = start                    # and again if SkyCRM closes it
      }
    }
  }
}
