# PRODUCTION tunnel: IPsec site-to-site between this gateway and SkyCRM's FortiGate.
# Copy to /etc/swanctl/conf.d/skycrm.conf and fill in from the settings SkyCRM sends.
# Every __PLACEHOLDER__ must match what they configure on their side, or phase 1/2 won't come up.
# Then set TUNNEL=ipsec and TUNNEL_IP=__OUR_TUNNEL_IP__ in /etc/samvadx-gateway.env.

connections {
  skycrm {
    version = 2                               # IKEv2 unless they say IKEv1
    local_addrs  = __PRIVATE_IP__             # this server (behind the cloud NAT)
    remote_addrs = __SKYCRM_PEER_IP__         # their FortiGate's public IP
    proposals = aes256-sha256-modp2048        # phase 1: encryption-hash-DH group they give
    rekey_time = 86400s                       # phase 1 lifetime
    dpd_delay = 30s
    encap = yes                               # NAT-T: we sit behind the cloud's 1:1 NAT

    local {
      auth = psk
      id = __PUBLIC_IP__                      # what they set as our peer ID
    }
    remote {
      auth = psk
      id = __SKYCRM_PEER_IP__
    }

    children {
      skycrm-sip {
        # Our side: one address for SIP + audio. It must not clash with SkyCRM's networks.
        local_ts  = __OUR_TUNNEL_IP__/32
        # Their side: the SIP server and the media servers (ask for the exact list).
        remote_ts = 10.173.16.0/24
        esp_proposals = aes256-sha256-modp2048  # phase 2
        rekey_time = 3600s                      # phase 2 lifetime
        start_action = start
        dpd_action = restart
      }
    }
  }
}

secrets {
  ike-skycrm {
    id = __SKYCRM_PEER_IP__
    secret = "__PRESHARED_KEY__"
  }
}

# __OUR_TUNNEL_IP__ is not on any interface yet. Add it so Kamailio and rtpengine can use it:
#   ip addr add __OUR_TUNNEL_IP__/32 dev lo
# (make it permanent with a netplan or systemd-networkd entry).
