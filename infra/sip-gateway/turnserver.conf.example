# coturn for the browser phone's audio on the SkyCRM-WebRTC route (enable-skycrm-webrtc.sh writes
# this to /etc/turnserver.conf). Browsers reach the relay on the server's public IP; the relay
# talks to SkyCRM from our tunnel address, so the audio goes through the IPsec tunnel.
# It relays ONLY to SkyCRM's network — never an open relay.

listening-port=3478
listening-ip=__LISTEN_IP__
relay-ip=__TUNNEL_IP__
min-port=49160
max-port=49999

realm=__DOMAIN__
use-auth-secret
static-auth-secret=__TURN_SECRET__

denied-peer-ip=0.0.0.0-255.255.255.255
allowed-peer-ip=__PEER_FROM__-__PEER_TO__
no-multicast-peers
no-tcp-relay
no-tls
no-dtls
no-cli
fingerprint
user-quota=4
total-quota=300
stale-nonce=600
syslog
simple-log
