# Copy to /etc/samvadx-gateway.env on the gateway server and fill in. Read by setup.sh and render.sh.

# Public name agents' browsers connect to (wss://DOMAIN/ws). Its DNS A record must point at PUBLIC_IP.
DOMAIN=voice.samvadx.com
# Email for the Let's Encrypt certificate.
CERTBOT_EMAIL=

# The server's fixed public IP, and the IP the server itself sees (behind the cloud's NAT).
# PRIVATE_IP is detected if left blank.
PUBLIC_IP=
PRIVATE_IP=

# SkyCRM's call system (the SIP registrar the extensions live on).
PBX_IP=10.173.16.10
PBX_PORT=5099

# How we reach SkyCRM:
#   ipsec    = the site-to-site tunnel (production, live since 2026-11-03). TUNNEL_IP is our end
#              of it, put on loopback by samvadx-tunnel-ip.service.
#   fortivpn = their SSL VPN (API_Test1), for testing only. tunnel-up.sh fills TUNNEL_IP on
#              connect. ONE connection per login: it knocks off any agent using API_Test1.
TUNNEL=ipsec
TUNNEL_IP=10.250.10.1
# SkyCRM's FortiGate (the IPsec peer; the same box as the SSL VPN).
SKYCRM_PEER_IP=118.185.178.161

# Web pages allowed to open a phone connection (a regex on the Origin header). Write a literal
# dot as [.], not \. (Kamailio's config strings don't take backslash escapes), and no quotes.
ALLOWED_ORIGINS='^https://([a-z0-9-]+[.])?samvadx[.]com$|^http://localhost(:[0-9]+)?$'

# SkyCRM's own WebRTC (option B, enable-skycrm-webrtc.sh): its secure WebSocket port, and the
# network the TURN relay may send audio to (never anything else).
PBX_WSS_PORT=8089
SKYCRM_NET_FROM=10.173.16.0
SKYCRM_NET_TO=10.173.16.255

# Kamailio's WebSocket port on localhost (nginx forwards to it). No reason to change.
WS_PORT=8090
